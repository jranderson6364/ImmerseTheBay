    - '// @input float verticalExaggeration = 4 {"hint":"Vertical exaggeration so 3-storey buildings are visible at map scale"}'
    - '// @input float radiusM = 700 {"hint":"Map radius in real metres. Hoover (662 m) and Cantor (641 m) need at least 670. Landmarks beyond it are pinned to the edge."}'
