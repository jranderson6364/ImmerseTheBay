  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Sightlines Map</span><br/><span style=\"color: #94A3B8; font-size: 11px;\">Builds the campus from Data/CampusData.ts at runtime.</span>"}'
