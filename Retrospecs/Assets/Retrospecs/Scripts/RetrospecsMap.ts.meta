  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Retrospecs Map</span><br/><span style=\"color: #94A3B8; font-size: 11px;\">Builds the campus from Data/CampusData.ts at runtime.</span>"}'
    - '// @input Asset.Material material {"hint":"Any material with a Base Color (e.g. Assets/Materials/White.mat). It is cloned per color."}'
    - '// @input Asset.ObjectPrefab labelPrefab {"hint":"Assets/Prefabs/WorldLabel.prefab"}'
    - '// @input float scaleDenominator = 600 {"hint":"Map scale 1:N. 600 -> 700 m is about 117 cm, so the disc is about 2.3 m across."}'
    - '// @input float verticalExaggeration = 4 {"hint":"Vertical exaggeration so 3-storey buildings are visible at map scale"}'
    - '// @input float radiusM = 700 {"hint":"Map radius in real metres. Hoover (662 m) and Cantor (641 m) need at least 670. Landmarks beyond it are pinned to the edge."}'
    - '// @input bool showOutlines = true {"hint":"Bright outline along every roof edge"}'
    - '// @input float outlineWidthCm = 0.2 {"hint":"Roof outline width in map cm (0.15-0.25 reads well)"}'
    - '// @input bool showCornerLines = true {"hint":"Thin vertical lines at sharp building corners (part of the outline mesh)"}'
    - '// @input float wallInsetCm = 0.04 {"hint":"Pull walls this far (cm) inside the roof edge so roofs and outlines overhang them"}'
    - '// @input bool showRoads = true {"hint":"Roads (OSM, Data/PathsData.ts) as flat ribbons under the buildings"}'
    - '// @input bool showBikePaths = true {"hint":"Bike paths, plus dashed stripes on roads with painted bike lanes"}'
    - '// @input bool showFootpaths {"hint":"Foot paths and sidewalks (dense; faint)"}'
    - '// @input float roadWidthCm = 1.3 {"hint":"Road width in map cm (8 m at 1:600 is about 1.3)"}'
    - '// @input float bikeWidthCm = 0.65 {"hint":"Bike path width in map cm (4 m at 1:600 is about 0.65)"}'
    - '// @input float footWidthCm = 0.4 {"hint":"Foot path width in map cm (2.5 m at 1:600 is about 0.4)"}'
    - '// @input float bikeLaneWidthCm = 0.4 {"hint":"Width of the dashed bike-lane stripe down roads, map cm"}'
    - '// @input float labelScale = 1.2 {"hint":"Map label size. The status caption is 0.6 at 70 cm; map labels are 1.5-3 m away."}'
    - '// @input bool useLandmarkModels = true {"hint":"Draw recognisable models for key landmarks (Hoover, Memorial Church, Main Quad, Huang...) instead of plain extrusions"}'
    - '// @input float sightlineLabelPerCm = 0.009 {"hint":"Real-direction beacon label size per cm of distance (0.009 matches the status caption)"}'
    - '// @ui {"widget":"group_start", "label":"Focus mode (a selected building)"}'
    - "// @input float focusScale = 1.8 {\"hint\":\"Focused building's scale (1.6-2 reads well)\"}"
    - '// @input float focusLiftCm = 1.2 {"hint":"Extra lift of the focused building (map cm)"}'
    - '// @input float backgroundScale = 0.35 {"hint":"Height scale of every other building while focused. Smaller, not gone."}'
    - '// @input float backgroundDim = 0.35 {"hint":"Brightness of everything else while focused (additive display: lower = more see-through)"}'
    - '// @input float focusInSec = 0.6 {"hint":"Seconds to go into focus"}'
    - '// @input float focusOutSec = 0.6 {"hint":"Seconds to come back out"}'
    - "// @input bool showFocusHalo = true {\"hint\":\"Soft ring at the focused building's base\"}"
    - '// @ui {"widget":"group_end"}'
