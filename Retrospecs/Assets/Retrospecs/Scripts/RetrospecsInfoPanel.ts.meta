  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Retrospecs Info Panel</span><br/><span style=\"color: #94A3B8; font-size: 11px;\">Focus-mode screen floating in front of the wearer (wall of TVs).</span>"}'
    - "// @input Asset.Material material {\"hint\":\"Any material with a Base Color (e.g. Assets/Materials/White.mat). Cloned per colour. If empty, the controller passes the map's.\"}"
    - "// @input SceneObject camera {\"hint\":\"Camera object (the wearer's head). Needed for the lazy follow.\"}"
    - '// @input Asset.Font font {"hint":"Optional font for the panel text (default font if empty)"}'
    - '// @input float panelWidthCm = 30 {"hint":"(Legacy, unused for placement)"}'
    - '// @input float panelHeightCm = 24 {"hint":"(Legacy, unused for placement)"}'
