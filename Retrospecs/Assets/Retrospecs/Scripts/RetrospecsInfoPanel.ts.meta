  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Retrospecs Info Panel</span><br/><span style=\"color: #94A3B8; font-size: 11px;\">Focus-mode screen floating in front of the wearer (wall of TVs).</span>"}'
    - "// @input Asset.Material material {\"hint\":\"Any material with a Base Color (e.g. Assets/Materials/White.mat). Cloned per colour. If empty, the controller passes the map's.\"}"
    - "// @input SceneObject camera {\"hint\":\"Camera object (the wearer's head). Needed for the lazy follow.\"}"
    - '// @input Asset.Font font {"hint":"Optional font for the panel text (default font if empty)"}'
    - '// @input float panelWidthCm = 30 {"hint":"(Legacy, unused for placement)"}'
    - '// @input float panelHeightCm = 24 {"hint":"(Legacy, unused for placement)"}'
    - '// @input float panelGapCm = 6 {"hint":"(Legacy, unused for placement)"}'
    - '// @input float screenWidthCm = 60 {"hint":"Main screen width (cm)"}'
    - '// @input float screenDistanceCm = 130 {"hint":"Distance from the eyes to the main screen (cm)"}'
    - '// @input float screenDropCm = 14 {"hint":"Main screen centre below eye height (cm)"}'
    - '// @input float followAngleDeg = 40 {"hint":"Re-centre the screens when you turn this far away (degrees)"}'
    - '// @input float followDistanceCm = 45 {"hint":"...or walk this far (cm)"}'
    - '// @input bool worldLocked = true {"hint":"Keep the screens fixed in the room where they appear (walk up to them). Off = lazy follow."}'
    - '// @input float distanceScale = 1.85 {"hint":"Multiplies Screen Distance: 1.85 puts the 130 cm screen about 2.4 m away"}'
    - "// @input float sizeScale = 1.5 {\"hint\":\"Multiplies the screen's size (text and art grow with it) so it stays readable farther back\"}"
    - '// @input float appearSec = 0.6 {"hint":"Seconds to fly out / back"}'
    - '// @input bool flyFromBuilding = true {"hint":"Fly out of the building (on) or fade in at the wall (off)"}'
    - "// @input float titleTextSize = 80 {\"hint\":\"Largest text sizes (max 80: larger text didn't render). Text wraps and the card grows to fit.\"}"
    - // @input float namesakeTextSize = 64
    - // @input float bodyTextSize = 72
    - // @input float smallTextSize = 50
    - '// @input bool showMedia = true {"hint":"Show artist art screens. Turn off to compare with the plain card."}'
    - '// @input Asset.Material mediaMaterial {"hint":"Material with a baseTex slot (Assets/Materials/CaptureTexture.mat). If empty, loaded by path."}'
    - // @input string media1Id
    - // @input Asset.Texture media1Texture
    - // @input string media2Id
    - // @input Asset.Texture media2Texture
    - // @input string media3Id
    - // @input Asset.Texture media3Texture
    - // @input string media4Id
    - // @input Asset.Texture media4Texture
    - '// @input float artMaxWidthCm = 56 {"hint":"Largest art size (cm)"}'
    - // @input float artMaxHeightCm = 24
    - '// @input float artLiftCm = 8 {"hint":"Raise the screen this much when it has art, so the art and the title share the central view (cm)"}'
    - '// @input float artCycleSec = 8 {"hint":"Seconds per art piece when a building has several"}'
    - '// @input bool compactCard = true {"hint":"Short, wide card: art on the left, words on the right, X to close, Next spot button. Off = the old tall card."}'
    - '// @input float compactPitchDeg = 12 {"hint":"Compact card: degrees below eye level for its centre, so it sits between the horizon and the floor map"}'
    - '// @input float compactDistanceScale = 1.45 {"hint":"(Legacy, unused: see Card Distance)"}'
    - '// @input float compactWidthCm = 90 {"hint":"(Legacy, unused: see Compact Width Deg)"}'
    - '// @input float cardDistanceCm = 140 {"hint":"Compact and story cards: distance from the eyes (cm). Snap: far field is 60-160 cm, about 1 m is most comfortable for detail."}'
    - "// @input float compactWidthDeg = 24 {\"hint\":\"Compact card width (degrees). Snap's usable binocular width is about 27.\"}"
    - "// @input float compactBodyLineDeg = 0.76 {\"hint\":\"Compact card body line height (degrees). Sets the text size, and with it the card's scale.\"}"
    - '// @input float storyCardWidthDeg = 20.3 {"hint":"Illustrated story card width (degrees, the whole texture including Next Stop)"}'
    - '// @input float minTargetDeg = 3 {"hint":"Smallest button hit area (degrees). Snap: at least 2, about 3 is best."}'
