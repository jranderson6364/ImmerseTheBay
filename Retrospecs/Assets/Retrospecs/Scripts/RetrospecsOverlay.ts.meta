  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Retrospecs Overlay</span><br/><span style=\"color: #94A3B8; font-size: 11px;\">Life-size nametag and outline on the real building you look at.</span>"}'
    - '// @input Asset.Material material {"hint":"Any material with a Base Color (e.g. Assets/Materials/White.mat). It is cloned per object."}'
