    - '// @input float labelHeightCm = 2 {"hint":"Height in cm of one WorldLabel title line at scale 1. Check in Preview and adjust so a tag at 20 m reads about 2.5 degrees tall."}'
    - '// @input float titleAngleDeg = 4.5 {"hint":"Target angular height of the building-name title, degrees (clamped to 3.5-6). Was 2.5, too small to read."}'
