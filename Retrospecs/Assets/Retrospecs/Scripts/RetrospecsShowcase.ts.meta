  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Retrospecs Showcase</span><br/><span style=\"color: #94A3B8; font-size: 11px;\">Exploded product models built at runtime from Core/Products.ts.</span>"}'
