  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Retrospecs Controller</span>"}'
    - // @input SceneObject camera
    - // @input AssignableType map
    - // @input AssignableType_1 guide
    - // @input AssignableType_2 asr
    - '// @ui {"widget":"group_start", "label":"Start point (one-pinch calibration)"}'
    - '// @input bool useStartPoint = true {"hint":"ON: stand on the known start point, face down the street, pinch once. OFF: the wall-pinch calibration at the survey spot below."}'
    - '// @input float startLat = 37.4281869 {"hint":"Default: where the North-South Axis (OSM: Via Crespi) crosses the East-West Axis, just east of Huang (OSM)."}'
    - // @input float startLon = -122.1735285
    - '// @input float startFacingDeg = 104.8 {"hint":"Compass bearing you face when you pinch. 104.8 = east down the East-West Axis, between Physics and Moore (OSM)."}'
    - '// @input string startInstruction = "Stand where the North-South and East-West axes cross. Face east down the walkway, between Physics and Moore, then pinch." {"hint":"Spoken/written instruction for the start point"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Where you stand (survey)"}'
    - '// @input float surveyLat = 37.427884 {"hint":"Latitude of the spot the wearer stands on. Default: Huang Engineering Center."}'
    - // @input float surveyLon = -122.17433
    - "// @input float wallBearing = 15 {\"hint\":\"Compass bearing of the calibration wall's direction (mod 90). Huang = 15.\"}"
    - '// @input float facingHint = 105 {"hint":"Roughly which way you face when looking at the calibration wall (deg). Snapped to the nearest wall face. Measure once at the venue."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Placement"}'
    - '// @input float eyeHeightCm = 160 {"hint":"Head height above the floor when standing (cm)"}'
    - "// @input float floorForwardCm = 140 {\"hint\":\"How far in front of you the floor map's centre sits (cm)\"}"
    - '// @input float tableHeightCm = 85 {"hint":"Map height above the floor in table mode (cm)"}'
    - '// @input float tableForwardCm = 55 {"hint":"How far in front of you the table-mode map sits (cm)"}'
    - // @input bool startLifted
    - '// @input float youAreHereHeightCm = 16 {"hint":"Height of the floating \"You are here\" tag above your pin on the map (map cm)"}'
    - // @input float youAreHereScale = 1.8
    - '// @input float handleRadiusCm = 4 {"hint":"Move/resize handle on the map rim: size and how close a pinch must be to grab it (cm)"}'
    - // @input float handleGrabCm = 10
    - '// @input float startMapScale = 0.65 {"hint":"Map size when it first unfolds (1 = 2.3 m across). Resize later with two hands or \"bigger\"/\"smaller\"."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Optional"}'
    - // @input Component.Text statusText
    - // @input bool showStatusLabel = true
    - // @input bool autoQuiz = true
    - '// @input bool persistProgress {"hint":"Keep heard facts across launches. Leave OFF for judging so every relaunch starts fresh."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Real-world visuals"}'
    - "// @input AssignableType_3 locator {\"hint\":\"GPS + Gemini: which real building am I looking at? Long right pinch or say \\\"what's that\\\".\"}"
    - '// @input AssignableType_4 overlay {"hint":"Nametag + roofline outline on the real building"}'
    - "// @input AssignableType_5 money {\"hint\":\"Life-size pile of $1 bills for the building's gift\"}"
    - '// @input bool moneyOnMap = true {"hint":"Indoor demo: put the money pile on the map instead of life-size in the room"}'
    - '// @input float moneyMapExaggeration = 3 {"hint":"Extra scale for the on-map pile (1 = true map scale)"}'
    - '// @input AssignableType_6 showcase {"hint":"Exploded product models shown while a fact is spoken"}'
    - '// @input float showcaseScaleCm = 40 {"hint":"Exploded model size (cm) and distance in front of you (cm)"}'
    - // @input float showcaseForwardCm = 75
    - '// @input float longPinchSec = 0.6 {"hint":"Hold a right pinch this long (s) to identify the real building instead"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Focus mode (selected building)"}'
    - '// @input AssignableType_7 infoPanel {"hint":"Floating card above the selected building: name, namesake, the fact, a number graphic"}'
    - "// @input bool askFurther = true {\"hint\":\"Ask further: when the checked notes don't cover a question about the building in focus, answer from the live web (Gemini + Google Search). Say \\\"look it up\\\" to go there directly.\"}"
    - '// @input string debugUtterance {"hint":"Dev: typed as if spoken ~4 s after calibrating (e.g. \"look up whether the Hoover deck is open\"). Leave empty."}'
    - '// @input float liveFollowUpSec = 45 {"hint":"Ask further: seconds after a live answer during which questions about the same building stay on the web path (follow-ups)"}'
    - "// @input Component.ScriptComponent experiences {\"hint\":\"Per-building 3D experience (RetrospecsExperiences). Shown to the wearer's left of the card.\"}"
    - '// @input float experienceScaleCm = 30 {"hint":"Experience size (world cm)"}'
    - '// @input float focusIdleSec = 25 {"hint":"Leave focus this many seconds after the guide stops talking (0 = never)"}'
    - '// @input bool showcaseNearBuilding = true {"hint":"ON: exploded model floats beside the focused building, right of the card. OFF: in front of you as before."}'
    - '// @input float focusSideGapCm = 4 {"hint":"Gap between the card and the side objects (world cm)"}'
    - '// @ui {"widget":"group_end"}'
