    - '// @input Asset.CameraModule camModule {"hint":"Only used when no DepthCache is set: requests the left color camera itself"}'
    - '// @ui {"widget":"group_start", "label":"Position"}'
    - '// @input float surveyLat = 37.427884 {"hint":"Fallback position (indoor / table mode / no fix). Default: Huang."}'
    - // @input float surveyLon = -122.17433
    - '// @input string spotId {"hint":"Force a spot id from Core/Locate.ts SPOTS (e.g. huang-table). Empty = auto from GPS."}'
    - '// @input float maxAccuracyM = 25 {"hint":"Worse GPS accuracy than this (m) = indoor/table mode"}'
    - '// @input float maxFixAgeS = 15 {"hint":"Ignore fixes older than this (s)"}'
    - // @input float gpsPollSec = 1
    - // @input bool enableGps = true
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Identify"}'
    - '// @input string model = "gemini-2.5-flash"'
    - "// @input float thinkingBudget {\"hint\":\"Gemini thinking budget; 0 = off (fastest). -1 = don't send the field.\"}"
    - // @input float timeoutSec = 6
    - // @input float halfAngleDeg = 30
    - // @input float maxDistM = 700
    - '// @input float maxCandidates = 8 {"hint":"Max candidates sent to Gemini (in-cone landmarks are always kept)"}'
