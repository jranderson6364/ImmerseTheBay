  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Retrospecs Locator</span><br/><span style=\"color: #94A3B8; font-size: 11px;\">GPS + Gemini vision: which real building is in view, and where.</span>"}'
    - // @input SceneObject camera
    - '// @input AssignableType map {"hint":"Its worldRoot (set at calibration) defines the compass frame"}'
